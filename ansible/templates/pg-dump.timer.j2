# Managed by cornil-gateway (ansible/pg-backup-deploy.yml). Do not edit by hand.
[Unit]
Description=Nightly PostgreSQL dumps

[Timer]
OnCalendar={{ pg_backup_calendar }}
RandomizedDelaySec={{ pg_backup_random_delay }}
# If the server was off at the scheduled time, run once when it is back.
Persistent=true

[Install]
WantedBy=timers.target
